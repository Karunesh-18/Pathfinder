# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Supabase (frontend) ---
# Project URL and anon key from your Supabase project's Settings > API page
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Edge Function secrets ---
# These are NOT read by the frontend. Set them via:
#   npx supabase secrets set OPENAI_API_KEY=sk-...
#   npx supabase secrets set REPLICATE_API_TOKEN=r8_...
#
# Required:
#   OPENAI_API_KEY           - Used by all text-generation edge functions
#   REPLICATE_API_TOKEN      - Used by generate-mental-model-images and generate-presentation-image
#
# Optional:
#   SUPABASE_SERVICE_ROLE_KEY - Automatically provided in edge functions; only needed for local scripts
