# Copy this file to .env at the project root and fill in real values.
# .env is gitignored — never commit real credentials.
#
# Only one variable is needed right now, for the Course & Skills Knowledge
# Base (stores/course-knowledge-base/db.py). If it's unset, the prototype
# falls back to a local SQLite file automatically — nothing else breaks.

# Supabase project's direct Postgres connection string.
# Find it at: Project Settings -> Database -> Connection string -> URI
# (use the direct connection, port 5432, not the pgbouncer pooler on 6543 —
# DDL like CREATE EXTENSION/CREATE TABLE needs a direct session connection)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Generic alternative name db.py also accepts, if you'd rather use a
# non-Supabase Postgres instance later:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq API key — the real LLM backend for the reasoning agents
# (services/intake-profiling, services/explainability-qa,
# services/progress-feedback, backend/chat_assistant.py). If unset, each
# falls back automatically to its rule-based stub — see common/llm.py.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Secret used to sign login JWTs (backend/auth_token.py). If unset, the
# backend falls back to a fixed, insecure development-only secret and
# prints a warning on first use — fine for local dev, never for a real
# deployment. Set this to any long random string in production.
JWT_SECRET=

# Extra CORS origins for the deployed frontend, comma-separated
# (backend/main.py already allows http://localhost:5173 by default).
ALLOWED_ORIGINS=
